<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_color">
    <item>
        <layer-list>
            <!-- Shadow/Glow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#0D8B5CF6" />
                </shape>
            </item>
            
            <!-- Main Glass Background -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="@color/bg_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/premium_border" />
                </shape>
            </item>
            
            <!-- Top Inner Glow -->
            <item android:bottom="20dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#1AFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
