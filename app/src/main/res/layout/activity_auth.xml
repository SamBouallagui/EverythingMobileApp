<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Branded Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="56dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_primary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/everything"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Small gradient accent -->
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="@drawable/bg_button_gradient"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

    <!-- Tab Layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_secondary"
        app:tabTextColor="@color/text_tertiary"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabIndicatorColor="@color/accent_primary"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabRippleColor="@color/ripple_color"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        android:elevation="0dp"/>

    <!-- View Pager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"/>

</LinearLayout>