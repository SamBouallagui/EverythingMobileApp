<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="New Post"
        android:elevation="4dp" />

    <!-- "Posting in" card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_stat_card"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_comm_general"
            android:tint="@color/accent_light"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Posting in"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tvPostingIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Community Name"
                android:textColor="@color/accent_light"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Post content area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card_glass"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What's on your mind?"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPostContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Share something with the community..."
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingMultiplier="1.5" />
    </LinearLayout>

    <!-- Bottom bar: char count + submit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_secondary"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/CharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 500"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <!-- Progress bar for char count -->
            <android.widget.ProgressBar
                android:id="@+id/charProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:max="500"
                android:progress="0"
                android:progressTint="@color/accent_primary"
                android:progressBackgroundTint="@color/divider" />
        </LinearLayout>

        <Button
            android:id="@+id/SubmitPost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Post"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:background="@drawable/bg_button_gradient"
            android:paddingHorizontal="32dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>