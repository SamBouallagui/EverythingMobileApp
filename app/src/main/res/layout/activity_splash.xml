<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Decorative outer ring -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0.04"
        android:background="@drawable/bg_avatar_ring"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Inner ring -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:alpha="0.06"
        android:background="@drawable/bg_avatar_ring"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/everything"
        android:textColor="@color/text_primary"
        android:textSize="42sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Gradient accent bar under title -->
    <View
        android:id="@+id/accentBar"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:background="@drawable/bg_button_gradient"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/tvTagLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/find_your_people"
        android:textSize="15sp"
        android:textColor="@color/text_tertiary"
        android:letterSpacing="0.08"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/accentBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>